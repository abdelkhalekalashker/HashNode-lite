<div class="col-md-10 bg-dark text-light">
  <% if @room %>
    <h4 class="text-center"> <%= @room.name %> </h4>
    <%= turbo_stream_from @room %>

    <div id="messages">
      <% @room.messages.each do |message| %>
      <%= render message %>
      <% end %>
    </div>
  <% end %>
  <%= render 'messages/form' %>
</div>
